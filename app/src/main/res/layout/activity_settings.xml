<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Повернутись назад" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="⚙️ Налаштування"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- BLE Controllers Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp"
                android:background="#2E2E2E"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎮 BLE Контролери"
                    android:textSize="20sp"
                    android:textColor="#4CAF50"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Player 1 Controller -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:background="#3E3E3E"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🐍 Гравець 1"
                        android:textSize="16sp"
                        android:textColor="#FFFFFF"
                        android:layout_gravity="center_vertical" />

                    <TextView
                        android:id="@+id/player1Status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="❌ Відключено"
                        android:textSize="14sp"
                        android:textColor="#F44336"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="12dp" />

                    <Button
                        android:id="@+id/connectPlayer1Button"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:text="Підключити"
                        android:textSize="12sp"
                        android:backgroundTint="#4CAF50"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- Player 2 Controller -->
                <LinearLayout
                    android:id="@+id/player2Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:background="#3E3E3E"
                    android:padding="12dp"
                    android:alpha="0.5">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🐍 Гравець 2"
                        android:textSize="16sp"
                        android:textColor="#FFFFFF"
                        android:layout_gravity="center_vertical" />

                    <TextView
                        android:id="@+id/player2Status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="❌ Відключено"
                        android:textSize="14sp"
                        android:textColor="#F44336"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="12dp" />

                    <Button
                        android:id="@+id/connectPlayer2Button"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:text="Підключити"
                        android:textSize="12sp"
                        android:backgroundTint="#4CAF50"
                        android:textColor="#FFFFFF"
                        android:enabled="false" />
                </LinearLayout>

                <!-- Connection Status -->
                <TextView
                    android:id="@+id/connectionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Натисніть 'Підключити' для пошуку контролера"
                    android:textSize="14sp"
                    android:textColor="#CCCCCC"
                    android:gravity="center"
                    android:background="#404040"
                    android:padding="12dp" />
            </LinearLayout>

            <!-- Game Settings Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp"
                android:background="#2E2E2E"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎯 Налаштування гри"
                    android:textSize="20sp"
                    android:textColor="#4CAF50"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Players Count -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="👥 Кількість гравців"
                        android:textSize="16sp"
                        android:textColor="#FFFFFF"
                        android:layout_gravity="center_vertical" />

                    <RadioGroup
                        android:id="@+id/playersRadioGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_gravity="center_vertical">

                        <RadioButton
                            android:id="@+id/onePlayerRadio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 гравець"
                            android:textColor="#FFFFFF"
                            android:checked="true"
                            android:layout_marginEnd="16dp" />

                        <RadioButton
                            android:id="@+id/twoPlayersRadio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 гравці"
                            android:textColor="#FFFFFF" />
                    </RadioGroup>
                </LinearLayout>

                <!-- Game Speed -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚡ Швидкість гри"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/speedValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Середня"
                            android:textSize="14sp"
                            android:textColor="#4CAF50" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/speedSeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50" />
                </LinearLayout>

                <!-- Field Size -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📐 Розмір поля"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/fieldSizeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Середнє"
                            android:textSize="14sp"
                            android:textColor="#4CAF50" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/fieldSizeSeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50" />
                </LinearLayout>
            </LinearLayout>

            <!-- Audio Settings Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp"
                android:background="#2E2E2E"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔊 Налаштування звуку"
                    android:textSize="20sp"
                    android:textColor="#4CAF50"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Master Volume -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🎵 Загальна гучність"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/volumeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50%"
                            android:textSize="14sp"
                            android:textColor="#4CAF50" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/volumeSeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50" />
                </LinearLayout>

                <!-- Sound Effects -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🎯 Звукові ефекти"
                        android:textSize="16sp"
                        android:textColor="#FFFFFF"
                        android:layout_gravity="center_vertical" />

                    <Switch
                        android:id="@+id/soundEffectsSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <Button
                    android:id="@+id/resetButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="🔄 Скинути"
                    android:textSize="16sp"
                    android:backgroundTint="#FF9800"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="💾 Зберегти"
                    android:textSize="16sp"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>